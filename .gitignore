# next.js
/.next/
next-env.d.ts

# 🔴 `/out/` عمداً اینجا نیست.
#
# خروجی `next export` است، ولی این پروژه اصلاً export نمی‌گیرد
# (همه‌ی صفحه‌ها پویا و server-rendered‌اند). در عوض یک صفحه‌ی واقعی
# به نام `app/(app)/inventory/out/page.tsx` داریم — «خروج کالا».
#
# الگوی `/out/` فقط ریشه را می‌گیرد، ولی ابزارهای همگام‌سازی و
# پاک‌سازی که نام پوشه را می‌بینند (نه مسیر کامل) آن صفحه را هم
# قربانی می‌کنند. سه بار در همین پروژه اتفاق افتاد و هر بار باگ ۴۰۴
# صفحه‌ی «خروج کالا» برگشت (اولین بار در ee7d2b1 رفع شده بود).
#
# اگر روزی export لازم شد، نام خروجی را عوض کنید:
#   next.config.mjs → distDir یا خروجی را به `dist/` بفرستید.

